create database gamingdb;
use gamingdb;

create table Accoun_t( AcctName varchar (50) primary key,
					  Pass_word varchar(100) not null,
                      lastSignedon datetime,
                      sbscrbrName varchar(50),
                      sbscrbrAddress varchar(100),
                      sbscrbrEmail varchar(50),
                      sbscrbrPhone varchar(15),
                      AcctCreatedOn date);
select * from Accoun_t;

use gamingdb;

create table Region ( RegionName varchar(50) primary key,
					 climate varchar(50),
                     precipitation varchar(50),
                     foliage varchar(50));
                     
use gamingdb;

create table Item ( ItemName varchar(50) primary key,
					ItemType varchar(50),
                    ItemDamage int);
                    
use gamingdb;

create table Creep ( CreepName varchar(50) primary key,
					HitPoints int,
                    Mana int,
                    Attack int);
                    
use gamingdb;

create table Characte_r ( CharName varchar(50) primary key,
						  Leve_l int,
                          ExpPoints int,
                          Typ_e varchar(50),
                          MaxHitPoints int,
                          MaxMana int,
                          CurrHitPoints int,
                          CurrMana int,
                          CreatedOn date,
                          LastPlayed datetime,
                          AcctName varchar(50),
                          RegionName varchar(50),
                          Foreign key (AcctName) references Accoun_t(AcctName),
						  Foreign key (RegionName) references Region(RegionName));
select * from characte_r;
use gamingdb;

create table ItemInstantiation(I_IDNum int primary key,
							   Modifier varchar(50),
                               WhenCreated datetime,
                               ItemName varchar(50),
                               foreign key (ItemName) references Item(ItemName));
select * from ItemInstantiation;

use gamingdb;

create table CreepInstantiation ( C_IDNum int primary key,
								  CreepName varchar(50),
                                  RegionName varchar(50),
                                  foreign key (CreepName) references Creep(CreepName),
                                  foreign key (RegionName) references Region(RegionName));
select * from CreepInstantiation;

# Relationships
#1. Account-Character (Has)
use gamingdb;
create table Acc_Char ( AcctName varchar(50),
						Lastplayed datetime,
                        CreatedOn date,
                        CharName varchar(50),
                        primary key (AcctName,Lastplayed,CreatedOn,CharName),
                        foreign key (AcctName) references Accoun_t (AcctName),
                        foreign key (CharName) references Characte_r(CharName));
select * from Acc_Char;
#2. Character-Creep(RANINTO)
use gamingdb;
create table RanInto( CharName varchar(50),
					  CreepName varchar(50),
                      primary key(CharName,CreepName),
                      foreign key (CharName) references Characte_r(CharName),
                      foreign key (CreepName) references Creep(CreepName));
select * from RanInto;       

#3. Character-ItemInstantiation(Carrying)
use gamingdb;    
create table Char_Item( CharName varchar(50),
						I_IDNum int,
                        primary key(CharName,I_IDNum),
                        foreign key (CharName) references Characte_r(CharName),
                        foreign key (I_IDNum) references ItemInstantiation (I_IDNum));
select * from Char_Item;

#4. Region-Character(Contains)
use gamingdb;
create table Reg_Char(RegionName varchar(50),
					  CharName varchar(50),
                      primary key (RegionName,CharName),
                      foreign key (RegionName) references Region (RegionName),
                      foreign key (CharName) references Characte_r(CharName));
select * from Reg_Char;

#5. Item-ItemInstantiation (IsType)
use gamingdb;
create table Istype(I_IDNum int,
					WhenCreated datetime,
                    ItemName varchar(50),
                    primary key(I_IDNum,WhenCreated,ItemName),
                    foreign key(I_IDNum) references ItemInstantiation (I_IDNum),
                    foreign key (ItemName) references Item (ItemName));
select * from Istype;       

#6. Creep-CreepInstantiation (Istype)
use gamingdb;   
create table CreepIns( CreepName varchar(50),
					   C_IDNum int,
                       primary key (CreepName,C_IDNum),
                       foreign key(CreepName) references Creep(CreepName),
                       foreign key(C_IDNum) references CreepInstantiation (C_IDNum));
select * from CreepIns;  

#7. Region-CreepInstantiation (Contains)
use gamingdb;
create table Contain_s(RegionName varchar(50),
					   C_IDNum int,
                       primary key (RegionName,C_IDNum),
                       foreign key (RegionName) references Region (RegionName),
                       foreign key (C_IDNum) references CreepInstantiation (C_IDNum));
select * from Contain_s;	

#8. ItemInstantiation-CreepInstantiation(Carrying)
use gamingdb;	
create table Carrying( C_IDNum int,
					   I_IDNum int,
                       primary key (C_IDNum,I_IDNum),
                       foreign key (C_IDNum) references CreepInstantiation (C_IDNum),
                       foreign key (I_IDNum) references ItemInstantiation (I_IDNum));
select * from Carrying;    

