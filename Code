# TRIGGERS
# 1.Before Insert
delimiter //
create trigger C_har
before insert 
on Characte_r
for each row
 set new.CurrHitPoints = new.MaxHitPoints;
 
 
 
delimiter //
create trigger before_ItemIns
before insert
on ItemInstantiation
for each row
set new.WhenCreated = now();




#2. After Insert
create table Account_details(AcctName varchar (50) primary key,
							Pass_word varchar(100) not null,
							lastSignedon datetime,
							sbscrbrName varchar(50),
							sbscrbrAddress varchar(100),
							sbscrbrEmail varchar(50),
							sbscrbrPhone varchar(15),
							AcctCreatedOn date,
                            EntryTime time);
delimiter //
create trigger Acc_Details
after insert
on Accoun_t
for each row
insert into Account_details values (new.AcctName,new.Pass_word,new.lastSignedon,new.sbscrbrName,new.sbscrbrAddress,new.sbscrbrEmail,new.sbscrbrPhone,new.AcctCreatedOn,curtime());



#3. Before Update

delimiter //
create trigger Char_before_update
before update
on Characte_r
for each row
begin
	if new.CurrHitPoints < 0 then
		set new.CurrHitPoints = 0;
    end if;
end;




delimiter //
create trigger before_update_char
before update
on Characte_r
for each row
begin
	if new.CurrMana > new.MaxMana then
		set new.CurrMana = new.MaxMana;
	end if;
end;




#4. After Update
create table Acc_after_update(AcctName varchar (50) primary key,
							  Pass_word varchar(100) not null,
							  lastSignedon datetime,
							  sbscrbrName varchar(50),
							  sbscrbrAddress varchar(100),
							  sbscrbrEmail varchar(50),
							  sbscrbrPhone varchar(15),
							  AcctCreatedOn date,
                              acc_description varchar(100));

delimiter //
create trigger after_update_Acc
after update
on Accoun_t
for each row
insert into Acc_after_update values( 1,concat("updated row at",now()));




#5. Before Delete
create table region_backup(RegionName varchar(50) primary key,
						   climate varchar(50),
                           precipitation varchar(50),
                           foliage varchar(50));

delimiter //
create trigger region_bef_del
before delete
on Region
for each row
begin 
	insert into region_backup values(old.RegionName,old.climate,old.precipitation,old.foliage,curtime());
end;



